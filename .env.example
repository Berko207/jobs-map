# Copy to .env.local and fill in what you have. .env.local is gitignored.
# Next.js reads it for the app. `npm run build` reads it for the data script.
# On Vercel, set the same names under Project Settings → Environment Variables.
# Leave a value empty to skip that integration.

# Live "Hiring now" counts from https://developer.adzuna.com/
# Optional. The build continues with DENUE + curated data if these are missing.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Save / Applied sync across devices. Optional. The app uses localStorage without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
